# backend/.env 템플릿. 이 파일을 .env로 복사해서 값을 채운다.
# .env는 커밋하지 않는다(.gitignore).

# 필수. 없으면 부팅이 실패한다.
# JWT 서명 키 — 기본값을 두지 않는 이유는, 리포지토리에 적힌 키로 누구나
# 관리자 토큰을 서명할 수 있게 되기 때문이다. 배포마다 다른 임의값을 쓴다.
JWT_SECRET=change-me
# 유저 이름은 `docker-compose.yml`의 `POSTGRES_USER`와 같아야 한다(root).
# 예전에는 `user`라, 예제대로 .env를 만들면 개발 DB에 붙지 못했다.
DATABASE_URL=postgresql://root:password@localhost:5432/playsync

# docker-compose.yml이 읽는다. postgres 컨테이너의 비밀번호이자, 시드
# 컨테이너가 조립하는 DATABASE_URL의 비밀번호다. 위 DATABASE_URL과 같은 값을
# 써야 호스트와 컨테이너가 같은 DB를 본다.
DATABASE_PASSWORD=password

# 선택. 아래는 코드상의 기본값과 같다.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
PORT=3001

# 리바인 대기 제한(ms).
REBUY_TIMEOUT_MS=15000

# 대회를 시작할 수 있는 최소 인원. 운영 기본값은 6이다.
# 로컬에서 수동 테스트할 때만 낮춘다 — 크롬 창을 6개 띄우고 각각 로그인하는
# 시간이 아까울 때. 배포 환경에서는 설정하지 않는다.
MIN_PLAYERS_TO_START=6

# WebSocket Origin 허용 목록(쉼표 구분).
WS_ALLOWED_ORIGINS=http://localhost:3000

# 요청율 상한(IP당). 아래는 코드상의 기본값과 같고, 그 값이 곧 방어값이다 —
# 설정하지 않는 것이 정상이다. 올리는 자리는 부하 무대뿐이다
# (`docker-compose.test.yml`의 backend-load). 근거는 `src/auth/throttle.ts`.
THROTTLE_WINDOW_MS=60000
THROTTLE_LIMIT=600
# 인증 라우트(`/auth/login` · `/auth/join` · `/dealer/auth`)만 따로. bcrypt가
# 도는 자리라 전역보다 좁다.
THROTTLE_AUTH_LIMIT=120
