{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": ".*\\.outage-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/src/$1",
    "^shared/(.*)$": "<rootDir>/shared/$1"
  },
  "testEnvironment": "node",
  "globalSetup": "<rootDir>/test/outage/global-setup.ts",
  "globalTeardown": "<rootDir>/test/outage/global-teardown.ts",
  "testTimeout": 180000,
  "maxWorkers": 1
}
