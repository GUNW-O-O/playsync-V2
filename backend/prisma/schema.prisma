// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- Enums ---

enum Role {
  USER
  DEALER
  STORE_ADMIN
  PLATFORM_ADMIN
}

/// 게임 방식. 지금은 한 가지뿐이다.
///
/// `SIT_AND_GO`가 선언만 돼 있었다(T71 9-3). `Tournament.type`을 읽고 분기하는
/// 코드가 한 줄도 없어서, 그 값으로 만든 대회가 `TOURNAMENT`와 완전히 같이
/// 동작했다 — API가 받아 주니 지원한다고 읽히는데 사실이 아니었다. 실제로
/// 구현할 때 다시 넣는다.
enum GameType {
  TOURNAMENT
}

enum TransactionType {
  CHARGE // 포인트 충전
  BUY_IN // 게임 참가비
  REBUY // 리바인/애드온
  PRIZE // 상금 수령
  REFUND // 취소 환불
  SETTLEMENT // 중단 정산 뒤 남은 돈이 상점 주인에게
}

enum TournamentStatus {
  PENDING // 생성 직후, 바이인 대기
  ONGOING // 게임 진행 중
  FINISHED // 최종 종료 (영구 데이터 보존 상태)

  /// 취소 — 시작 전에 닫고 참가비를 전액 환불했다.
  ///
  /// `FINISHED`와 섞지 않는다. `FINISHED`는 "걷은 참가비 == 나간 상금"이
  /// 맞아떨어져야 달리는 값이고(`completeSession`의 게이트), 취소는 그
  /// 게이트를 지나지 않는다. 같은 값을 쓰면 정산까지 끝난 대회와 무른 대회를
  /// 나중에 영영 가를 수 없다.
  CANCELLED
}

/// 참가자의 생애. **`WAITING`과 `RELEASED`를 가르는 것이 이 enum의 핵심이다.**
///
/// 둘 다 "지금 자리에 없다"인데 뜻이 반대다. `WAITING`은 결제만 하고 아직 한
/// 번도 안 앉은 사람(노쇼가 여기 머문다)이고, `RELEASED`는 앉았다가 상점이
/// 좌석을 뗀 사람(T29)이라 **살아 있고 칩도 있다.** T55 전에는 해제가
/// `WAITING`으로 되돌려서 둘이 같은 값이었고, 그래서 `activePlayers`가 셀
/// 대상을 상태만으로 고를 수 없었다.
enum PlayerStatus {
  WAITING // 바이인 완료 후 대기 — 아직 한 번도 앉지 않았다
  PLAYING // 테이블 착석 중
  RELEASED // 상점이 좌석을 해제했다. 살아 있고 칩도 있다 — 다시 앉으면 PLAYING
  ELIMINATED // 탈락
  AWARDED // 상금권 진입 후 종료
}

// --- Models ---

model User {
  id       String @id @default(uuid())
  nickname String @unique
  password String
  points   Int    @default(0) // 실제 가용 포인트
  role     Role   @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tablePlayers             TablePlayer[]
  stores                   Store[]
  transactions             PointTransaction[]
  tournamentParticipations TournamentParticipation[]
}

model PointTransaction {
  id           String          @id @default(uuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id])
  amount       Int // 포인트 변동량
  type         TransactionType
  tournamentId String? // 어떤 게임 세션에서 발생했는지
  description  String? // "1번 테이블 리바인" 등 비고
  createdAt    DateTime        @default(now())
}

model Store {
  id      String @id @default(uuid())
  name    String
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  tournaments     Tournament[]
  blindStructures BlindStructure[]

  createdAt DateTime @default(now())

  // 이름은 소유자 안에서만 유일하다. 전역 유니크였을 때는 남이 먼저 쓴
  // 이름을 못 쓰고, 그 실패가 다른 테넌트의 이름을 떠보는 통로가 됐다.
  @@unique([ownerId, name])
}

model BlindStructure {
  id   String @id @default(uuid())
  name String

  structure Json // [{lv:1, sb:100, ante:false, duration:10}, ...]

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  tournaments Tournament[]

  createdAt DateTime @default(now())

  // Store.name과 같은 이유. 상점 안에서만 유일하다.
  @@unique([storeId, name])
}

model Tournament {
  id     String           @id @default(uuid())
  name   String
  type   GameType         @default(TOURNAMENT)
  status TournamentStatus @default(PENDING)

  blindId        String
  blindStructure BlindStructure @relation(fields: [blindId], references: [id])
  entryFee       Int            @default(0)
  startStack     Int            @default(0)
  itmCount       Int            @default(0) // prizePayouts.length에서 파생된다. 기본값이 3이면 빈 prizePayouts와 모순이었다(T71)

  // 상금 분배율. [{place:1, percent:50}, ...] 이고 percent 합이 100이다.
  // 대회 생성 시 상점이 정한다 — 코드가 정할 수 있는 값이 아니라 기본값이 없다.
  prizePayouts Json @default("[]")

  // 실시간 전광판용 데이터
  rebuyUntil         Int     @default(0)
  isRegistrationOpen Boolean @default(true) // 레지 마감 여부
  totalBuyinAmount   Int     @default(0) // 바이인 누적 총 금액
  activePlayers      Int     @default(0)
  totalPlayers       Int     @default(0)
  avgStack           Int     @default(0)

  // 평문은 생성·재발급 응답에 한 번만 실린다. 저장은 해시로만 한다.
  dealerOtpHash String

  storeId                 String
  store                   Store                     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  tables                  Table[]
  tablePlayers            TablePlayer[]
  dealerSession           DealerSession?
  tornamentParticipations TournamentParticipation[]

  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  /// 장애로 정지한 **누적** 시간(ms). 블라인드 시계의 기준점을 이만큼 뒤로
  /// 민다.
  ///
  /// 누적인 이유: 대회 하나가 두 번 장애를 겪을 수 있고, 그때 Redis의
  /// 기준점은 이미 첫 번째만큼 밀려 있으므로 두 번째는 더해야 맞다.
  /// 덮어쓰면 첫 번째가 사라진다.
  ///
  /// `startedAt`과 뜻이 다르다. `startedAt`은 대회가 실제로 시작한 시각이고
  /// 절대 밀리지 않는다. 미는 것은 Redis `BlindField.startedAt`이다.
  pausedMs Int @default(0)
}

model Table {
  id         String @id @default(uuid())
  /// 대회 안에서의 테이블 번호. **전역 시퀀스가 아니다.**
  ///
  /// `@default(autoincrement())`가 붙어 있었는데 쓰는 데가 없었다(T71 9-3) —
  /// `createSession`은 1, `insertTable`은 대회별 `max+1`, 시드 둘은 명시값이다.
  /// 명시 INSERT는 시퀀스를 밀지 않으므로, 언젠가 기본값에 기대는 경로가
  /// 생기면 `@@unique([tournamentId, tableOrder])`에 즉시 P2002로 걸린다.
  tableOrder Int

  dealerId      String
  dealerSession DealerSession @relation(fields: [dealerId], references: [id])
  tournamentId  String
  tournament    Tournament    @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  tablePlayers TablePlayer[]

  /// 직전 핸드의 버튼 좌석. `TablePlayer.seatPosition`과 같은 좌표계다.
  ///
  /// `TableState`의 필드 중 DB에서 파생되지 않는 유일한 값이다 — 나머지는
  /// 현재 사실(누가 어디 앉았고 칩이 얼마인가)에서 나오는데 버튼만 "지난
  /// 핸드에 누가 버튼이었나"의 함수다. 그래서 스냅샷을 잃으면 이것만
  /// 복구할 근거가 없다.
  ///
  /// 시작 전에는 값이 없다(`null`). 시작 트랜잭션이 첫 추첨 결과를 쓰고,
  /// 그 뒤에는 핸드 종료 체크포인트가 갱신한다.
  buttonUser Int?

  @@unique([tournamentId, id])
  // 번호는 물리 테이블을 가리킨다. 겹치면 딜러와 전광판이 서로 다른 테이블을
  // 같은 번호로 부른다. 재시도 코드가 아니라 제약으로 막는다.
  @@unique([tournamentId, tableOrder])
}

model TablePlayer {
  id       String  @id @default(uuid())
  nickname String?

  tableId String
  table   Table  @relation(fields: [tableId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  seatPosition Int // 0~8 (9인테이블)

  joinedAt     DateTime    @default(now())
  tournamentId String?
  tournament   Tournament? @relation(fields: [tournamentId], references: [id])

  @@unique([tableId, seatPosition])
  @@unique([tableId, userId])
  // 좌석은 대회 안에서 하나다. `tableId`가 다르면 위 두 제약이 못 막으므로
  // 여기서 막는다 — 같은 OTP를 두 테이블에서 동시에 입력하는 경합이 실제
  // 시나리오다(T28 리뷰 finding 1). `tournamentId`가 nullable이라 Postgres는
  // 그 값이 NULL인 행끼리는 이 제약으로 묶지 않는데, 실제로는 걸릴 일이
  // 없다: `tournamentId`를 NULL로 만드는 유일한 경로는 대회 삭제의
  // `ON DELETE SET NULL`인데, 같은 삭제가 그 대회의 `Table`도 CASCADE로
  // 지우고 `tableId`는 `onDelete: Cascade`라 이 행 자체가 사라진다. 두 참조
  // 무결성 트리거 중 어느 쪽이 먼저 도는지는 Postgres가 정해 주지 않지만
  // 결과는 같다 — SET NULL이 먼저 돌아도 그 행은 곧이어 CASCADE로 지워지고,
  // CASCADE가 먼저 돌면 SET NULL이 건드릴 행이 없다. 어느 쪽이든 NULL인 채로
  // 살아남는 행은 생기지 않는다. 실제 대회 삭제로 확인했다
  // (`DELETE FROM "Tournament"` 후 해당 `TablePlayer` 행이 NULL이 아니라
  // 통째로 사라졌다). 현재 유일한 쓰기 경로(entry.service.ts)도 tournamentId를
  // 채우므로, 이 제약은 지금 존재하는 모든 행에 실제로 걸린다.
  @@unique([tournamentId, userId])
}

model TournamentParticipation {
  id           String     @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  status      PlayerStatus @default(WAITING)
  buyInCount  Int          @default(1)
  finalPlace  Int?
  prizeAmount Int          @default(0)

  /// 현재 칩 스택. 예전에는 `TablePlayer`에 있었는데, 상점이 좌석을 해제하면
  /// (T29) 그 행이 사라지면서 칩도 함께 사라졌다. `TablePlayer`는 좌석
  /// 배치표이고 이쪽이 장부다 — 칩은 좌석보다 오래 산다.
  currentStack Int @default(0)

  /// 참가 OTP. 평문이다 — 마이페이지에서 다시 볼 수 있어야 하고 권한이
  /// 좌석 하나뿐이다. 노출은 PrismaService의 클라이언트 수준 omit이 막는다.
  playerOtp String

  createdAt DateTime @default(now())

  @@unique([tournamentId, userId])
  @@unique([tournamentId, playerOtp])
}

model DealerSession {
  // 토너먼트id 로 otp 인증후 맞으면 반환 로컬스토리지에 저장.
  id String @id @default(uuid())

  // 상점이 딜러를 내보내면 올라간다. 갱신이 이 값을 대조하므로 기존 토큰은
  // 남은 만료 시간(최대 1시간) 안에 소멸한다.
  tokenVersion Int @default(0)

  tournamentId String     @unique
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  tables       Table[]
}

/// 서버가 마지막으로 살아 있던 시각. 행이 하나다 — "한 행사장 한 프로세스"가
/// 배치 단위라(backlog.md의 B9) 이 서버가 죽으면 그가 든 모든 대회가 같이
/// 죽는다. 대회별로 다른 다운타임이 나올 수 없다.
///
/// Redis가 아니라 DB에 산다. Redis에 두면 Redis를 잃은 케이스에서 하트비트도
/// 같이 사라져 다운타임을 알 방법이 없어진다 — 정확히 필요한 순간에 없다.
///
/// `@updatedAt`을 쓰지 않는다. 이 값은 **Redis ping이 성공했을 때만** 올라가야
/// 하므로, 조건과 값의 관계가 코드 한 자리에 보여야 한다.
model ServerHeartbeat {
  id     String   @id @default("singleton")
  beatAt DateTime
}
