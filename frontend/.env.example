# frontend/.env 템플릿. 이 파일을 .env.local로 복사해서 값을 채운다.
# .env*는 커밋하지 않는다(.gitignore). 이 예시 파일만 예외로 추적한다.

# 서버 컴포넌트/서버 액션이 백엔드를 직접 호출할 때 쓴다.
# 브라우저에 노출되지 않으므로 배포에서는 내부 주소를 넣어도 된다.
BACKEND_URL=http://localhost:3001

# 클라이언트 컴포넌트가 쓴다. 번들에 그대로 박히므로 공개 주소만 넣는다.
# WebSocket 주소는 이 값의 http를 ws로 바꿔 만든다.
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# apiFetch()가 경로 앞에 붙이는 오리진.
# 비워 두면 상대 경로로 나가고 next.config.ts의 /api/* rewrite가 백엔드로
# 넘긴다. 로컬에서는 비워 두는 것이 기본이다.
NEXT_PUBLIC_API_BASE=
